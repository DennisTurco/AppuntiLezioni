    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="raggio" type="Real" array="False" size=""/>
            <declare name="area" type="Real" array="False" size=""/>
            <output expression="&quot;Inserisci il valore del raggio&quot;" newline="False"/>
            <input variable="raggio"/>
            <assign variable="area" expression="raggio * raggio * 3.14"/>
            <output expression="&quot;Area = &quot; &amp; area &amp; &quot;. Diametro = &quot; &amp; raggio*2" newline="True"/>
        </body>
    </function>
